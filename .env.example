# ==============================================================================
# CoWork Space Desk & Room Booking System - Environment Variables
# ==============================================================================

# Backend Configuration (backend/.env)
NODE_ENV=development
PORT=4000
TZ=UTC
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/cowork
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:4000/api
