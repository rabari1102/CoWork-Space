NODE_ENV=development
PORT=4000

# Wall-clock times are stored as-is, so run the API in the venue's timezone.
TLZ=UTC

DATABASE_URL=postgresql://cowork:cowork@localhost:5432/cowork

# Change these before deploying anywhere real.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# Login and register throttling.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
